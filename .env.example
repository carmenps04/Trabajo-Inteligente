# Copia este archivo como .env y completa tus valores. NUNCA subas el .env.

# API key de Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Opcional: modelos de Gemini por agente, en orden de preferencia y
# separados por coma. La cuota gratuita es POR MODELO: si el primero
# agota su cuota del día, se usa el siguiente.
# Si no los pones, se usan los valores por defecto de app/llm.py.
# GEMINI_MODELO_LUPA=gemini-3.5-flash-lite,gemini-3.1-flash-lite
# GEMINI_MODELO_PLUMA=gemini-3.6-flash,gemini-3-flash-preview
# GEMINI_MODELO_BRUJULA=gemini-3.8-flash,gemini-3.6-flash
# GEMINI_MODELO_NOTARIO=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.8-flash
# GEMINI_MODELO=          # para todos los agentes (los de arriba mandan)
# Cualquier proveedor de LiteLLM, con "proveedor/modelo":
# LLM_MODELOS_PLUMA=gemini/gemini-3.6-flash,groq/openai/gpt-oss-120b

# ---- Respaldo cuando Gemini no puede (cuota agotada, caído) ----
# Se usan en orden, después de los modelos de Gemini del agente.
#
# Groq: gratis y muy rápido. Crea la key en https://console.groq.com/keys
# GROQ_API_KEY=
# GROQ_MODELO=openai/gpt-oss-120b      # el de por defecto (plan gratuito)
#
# Ollama: IA local, sin cuota (más lento sin tarjeta gráfica).
# Instálalo desde https://ollama.com y descarga un modelo, por ejemplo:
#   ollama pull qwen2.5:7b
# OLLAMA_MODELO=qwen2.5:7b
# OLLAMA_URL=http://localhost:11434
#
# O la lista completa a mano (vacío = sin respaldo):
# LLM_RESPALDO=groq/openai/gpt-oss-120b,ollama_chat/qwen2.5:7b

# Cadena de conexión de Supabase: Connect > "Session pooler" (puerto 5432).
# postgresql://postgres.<id-proyecto>:CONTRASEÑA@aws-0-<region>.pooler.supabase.com:5432/postgres
# - Sin comillas y sin los corchetes de [YOUR-PASSWORD].
# - Si la contraseña lleva @ # / : codifícalos (@ -> %40, # -> %23, / -> %2F, : -> %3A),
#   o mejor, elige una contraseña solo con letras y números.
# - Evita la "Direct connection" (db.<id>.supabase.co): solo funciona por IPv6.
# Compruébalo con:  python -m scripts.comprobar_env --conectar
SUPABASE_DB_URL=

# ---- Login (obligatorio al publicar la app en internet) ----
# Contraseña para entrar en la app. En tu PC es opcional: si la dejas
# vacía, no hay login. En Cloud Run la app NO arranca sin ella, y debe
# tener al menos 12 caracteres. Mejor una frase larga que no uses en
# otro sitio. Si la cambias, se cierran todas las sesiones abiertas.
# APP_PASSWORD=
